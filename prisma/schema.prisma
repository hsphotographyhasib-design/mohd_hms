generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Attendance {
  id          String    @id
  tenantId    String
  userId      String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  checkInGps  String?
  checkOutGps String?
  hoursWorked Float?
  status      String    @default("present")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@unique([tenantId, userId, date])
  @@index([tenantId, userId])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  details   String?
  ipAddress String?
  userAgent String?
  device    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityId])
  @@index([tenantId, entity])
  @@index([tenantId, createdAt])
}

model AuthAuditLog {
  id        String   @id
  tenantId  String?
  userId    String?
  email     String?
  event     String
  success   Boolean  @default(true)
  ipAddress String?
  userAgent String?
  device    String?
  browser   String?
  metadata  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([event])
  @@index([ipAddress])
  @@index([email])
  @@index([tenantId, createdAt])
}

model BroadcastLog {
  id             String    @id
  tenantId       String
  title          String
  content        String
  templateId     String?
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  failedCount    Int       @default(0)
  readCount      Int       @default(0)
  status         String    @default("draft")
  scheduledAt    DateTime?
  sentAt         DateTime?
  completedAt    DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

model ChecklistTemplate {
  id          String   @id
  tenantId    String
  name        String
  category    String
  description String?
  items       String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model CmsActivityLog {
  id        String   @id
  tenantId  String
  userId    String?
  action    String
  section   String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model CmsAnnouncement {
  id            String    @id
  tenantId      String
  text          String
  type          String    @default("info")
  link          String?
  isEnabled     Boolean   @default(true)
  scheduledFrom DateTime?
  scheduledTo   DateTime?
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime

  @@index([tenantId])
}

model CmsBlog {
  id              String           @id
  tenantId        String
  title           String
  slug            String
  excerpt         String?
  content         String?
  featuredImage   String?
  categoryId      String?
  authorId        String?
  status          String           @default("draft")
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  isFeatured      Boolean          @default(false)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  viewCount       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  CmsBlogCategory CmsBlogCategory? @relation(fields: [categoryId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model CmsBlogCategory {
  id          String    @id
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  CmsBlog     CmsBlog[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model CmsCareerApplication {
  id           String       @id
  tenantId     String
  jobId        String
  fullName     String
  email        String
  phone        String?
  resumeUrl    String?
  coverLetter  String?
  status       String       @default("new")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  CmsCareerJob CmsCareerJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CmsCareerJob {
  id                   String                 @id
  tenantId             String
  title                String
  department           String?
  description          String?
  requirements         String?
  salary               String?
  status               String                 @default("open")
  applicationDeadline  DateTime?
  location             String?
  type                 String                 @default("fulltime")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  CmsCareerApplication CmsCareerApplication[]

  @@index([tenantId])
}

model CmsContactMessage {
  id           String    @id
  tenantId     String
  name         String
  email        String
  phone        String?
  subject      String?
  message      String
  source       String    @default("website")
  status       String    @default("new")
  assignedToId String?
  reply        String?
  replyAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([tenantId])
}

model CmsFooter {
  id                 String   @id
  tenantId           String
  companyDescription String?
  address            String?
  phone              String?
  email              String?
  whatsapp           String?
  facebook           String?
  instagram          String?
  linkedin           String?
  twitter            String?
  youtube            String?
  copyrightText      String?
  privacyPolicyLink  String?
  termsLink          String?
  menuLinks          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime

  @@index([tenantId])
}

model CmsForm {
  id        String   @id
  tenantId  String
  name      String
  formType  String   @default("contact")
  fields    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([tenantId])
}

model CmsHero {
  id              String    @id
  tenantId        String
  headline        String?
  subheadline     String?
  backgroundImage String?
  backgroundVideo String?
  cta1Text        String?
  cta1Link        String?
  cta2Text        String?
  cta2Link        String?
  stat1Value      String?
  stat1Label      String?
  stat2Value      String?
  stat2Label      String?
  stat3Value      String?
  stat3Label      String?
  chipText        String?
  chipSubtext     String?
  isActive        Boolean   @default(true)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime

  @@index([tenantId])
}

model CmsIndustry {
  id           String   @id
  tenantId     String
  name         String
  description  String?
  image        String?
  icon         String?
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([tenantId])
}

model CmsMedia {
  id           String   @id
  tenantId     String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  folder       String?
  category     String?
  alt          String?
  width        Int?
  height       Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([tenantId])
}

model CmsPopup {
  id            String    @id
  tenantId      String
  title         String
  content       String?
  type          String    @default("welcome")
  imageUrl      String?
  frequency     String    @default("once")
  isEnabled     Boolean   @default(true)
  scheduledFrom DateTime?
  scheduledTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime

  @@index([tenantId])
}

model CmsProject {
  id                String    @id
  tenantId          String
  title             String
  slug              String
  description       String?
  category          String?
  featuredImage     String?
  images            String?
  beforeAfterImages String?
  completionStatus  String    @default("planned")
  isFeatured        Boolean   @default(false)
  galleryImages     String?
  seoTitle          String?
  seoDescription    String?
  displayOrder      Int       @default(0)
  status            String    @default("draft")
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model CmsSeo {
  id            String   @id
  tenantId      String
  pagePath      String
  title         String?
  description   String?
  keywords      String?
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  schemaMarkup  String?
  canonicalUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@unique([tenantId, pagePath])
  @@index([tenantId])
}

model CmsService {
  id             String   @id
  tenantId       String
  name           String
  slug           String
  description    String?
  image          String?
  icon           String?
  category       String?
  status         String   @default("draft")
  seoTitle       String?
  seoDescription String?
  displayOrder   Int      @default(0)
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model CmsSetting {
  id        String   @id
  tenantId  String
  key       String
  value     String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@unique([tenantId, key])
  @@index([tenantId])
}

model CmsTestimonial {
  id           String   @id
  tenantId     String
  customerName String
  company      String?
  photo        String?
  rating       Int
  comment      String
  status       String   @default("draft")
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([tenantId])
}

model Complaint {
  id                                String              @id
  tenantId                          String
  customerId                        String
  equipmentId                       String?
  title                             String
  description                       String
  priority                          String              @default("medium")
  status                            String              @default("NEW")
  complaintNumber                   String?
  source                            String              @default("admin")
  category                          String?
  photos                            String?
  gpsLocation                       String?
  assignedToId                      String?
  supervisorId                      String?
  assignedBy                        String?
  assignedByRole                    String?
  assignedAt                        DateTime?
  lastReassignedAt                  DateTime?
  assignmentReason                  String?
  assignmentStatus                  String              @default("UNASSIGNED")
  reassignmentCount                 Int                 @default(0)
  slaResponseDeadline               DateTime?
  workOrderId                       String?
  invoiceId                         String?
  eta                               String?
  rejectionReason                   String?
  reworkReason                      String?
  customerSnapshot                  String?
  locationInfo                      String?
  resolutionNotes                   String?
  customerRating                    Int?
  customerFeedback                  String?
  acceptedAt                        DateTime?
  startedAt                         DateTime?
  completedAt                       DateTime?
  clientConfirmedAt                 DateTime?
  resolvedAt                        DateTime?
  closedAt                          DateTime?
  createdAt                         DateTime            @default(now())
  updatedAt                         DateTime
  User_Complaint_supervisorIdToUser User?               @relation("Complaint_supervisorIdToUser", fields: [supervisorId], references: [id])
  User_Complaint_assignedToIdToUser User?               @relation("Complaint_assignedToIdToUser", fields: [assignedToId], references: [id])
  equipment                         Equipment?          @relation(fields: [equipmentId], references: [id])
  customer                          Customer            @relation(fields: [customerId], references: [id])
  tenant                            Tenant              @relation(fields: [tenantId], references: [id])
  ComplaintTimeline                 ComplaintTimeline[]
  WorkOrder                         WorkOrder[]

  @@index([tenantId, createdAt])
  @@index([tenantId, category])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedBy])
  @@index([tenantId, assignedToId])
  @@index([tenantId, status])
}

model ComplaintTimeline {
  id              String    @id
  tenantId        String
  complaintId     String
  action          String
  fromStatus      String?
  toStatus        String?
  description     String
  performedBy     String?
  performedByRole String?
  metadata        String?
  createdAt       DateTime  @default(now())
  complaint       Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@index([complaintId, createdAt])
  @@index([tenantId, complaintId])
}

model ConversationThread {
  id              String            @id
  tenantId        String
  sessionId       String
  subject         String?
  status          String            @default("active")
  assignedToId    String?
  lastMessageAt   DateTime          @default(now())
  messageCount    Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  WhatsAppSession WhatsAppSession   @relation(fields: [sessionId], references: [id])
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  WhatsAppMessage WhatsAppMessage[]

  @@index([assignedToId])
  @@index([sessionId])
  @@index([tenantId, status])
}

model Customer {
  id                   String               @id
  tenantId             String
  name                 String
  email                String?
  phone                String
  address              String?
  gpsLocation          String?
  companyName          String?
  customerNumber       String               @unique
  photo                String?
  paymentTerms         String?
  pic                  String?
  country              String?              @default("Brunei")
  district             String?
  taxRate              Float                @default(0)
  isActive             Boolean              @default(true)
  isWhatsappVerified   Boolean              @default(false)
  whatsappId           String?
  whatsappPhone        String?
  lastWhatsappActivity DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  Complaint            Complaint[]
  ConversationThread   ConversationThread[]
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  CustomerFeedback     CustomerFeedback[]
  CustomerReport       CustomerReport[]
  Equipment            Equipment[]
  Invoice              Invoice[]
  Quotation            Quotation[]
  WhatsAppSession      WhatsAppSession[]
  WorkOrder            WorkOrder[]

  @@index([tenantId, isActive])
  @@index([tenantId, phone])
  @@index([tenantId])
}

model CustomerFeedback {
  id          String   @id
  tenantId    String
  customerId  String
  complaintId String?
  workOrderId String?
  rating      Int
  comment     String?
  source      String   @default("whatsapp")
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, customerId])
}

model CustomerReport {
  id              String    @id
  tenantId        String
  customerId      String
  sessionId       String?
  type            String    @default("escalation")
  subject         String
  description     String
  priority        String    @default("medium")
  status          String    @default("OPEN")
  resolvedById    String?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  customer        Customer  @relation(fields: [customerId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

model Department {
  id          String       @id
  tenantId    String
  name        String
  description String?
  headId      String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  HrEmployee  HrEmployee[]
  User        User[]

  @@index([tenantId])
}

model Device {
  id        String   @id
  tenantId  String
  userId    String
  name      String?
  type      String?
  browser   String?
  os        String?
  ipAddress String?
  userAgent String?
  lastSeen  DateTime @default(now())
  isTrusted Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId])
  @@index([userId])
}

model DeviceToken {
  id         String   @id
  tenantId   String
  userId     String
  token      String   @unique
  platform   String
  browser    String?
  os         String?
  deviceName String?
  userAgent  String?
  ipAddress  String?
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  user       User     @relation(fields: [userId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([token])
  @@index([tenantId, isActive])
  @@index([tenantId, userId])
}

model EmailLog {
  id                String         @id
  tenantId          String
  recipient         String
  cc                String?
  bcc               String?
  subject           String
  templateId        String?
  templateName      String?
  module            String?
  status            String         @default("queued")
  provider          String         @default("brevo")
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  retryCount        Int            @default(0)
  maxRetries        Int            @default(5)
  nextRetryAt       DateTime?
  scheduledFor      DateTime?
  ip                String?
  userAgent         String?
  metadata          String?
  attachmentCount   Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  bouncedAt         DateTime?
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  EmailTemplate     EmailTemplate? @relation(fields: [templateId], references: [id])

  @@index([createdAt])
  @@index([providerMessageId])
  @@index([nextRetryAt])
  @@index([scheduledFor])
  @@index([status])
  @@index([recipient])
  @@index([tenantId, module])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model EmailTemplate {
  id          String     @id
  tenantId    String
  name        String
  identifier  String
  subject     String
  module      String
  description String?
  bodyHtml    String
  bodyText    String?
  variables   String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  EmailLog    EmailLog[]
  tenant      Tenant     @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, identifier])
  @@index([tenantId, module])
}

model Equipment {
  id              String           @id
  tenantId        String
  customerId      String?
  name            String
  category        String
  assetNumber     String           @unique
  qrCode          String           @unique
  qrId            String?          @unique
  brand           String?
  model           String?
  serialNumber    String?
  location        String?
  building        String?
  room            String?
  installDate     DateTime?
  warrantyExpiry  DateTime?
  warrantyInfo    String?
  status          String           @default("active")
  condition       String           @default("good")
  photos          String?
  documents       String?
  specifications  String?
  notes           String?
  scanCount       Int              @default(0)
  lastScannedAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  Complaint       Complaint[]
  customer        Customer?        @relation(fields: [customerId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  EquipmentQrCode EquipmentQrCode?
  PmSchedule      PmSchedule[]
  ScanLog         ScanLog[]
  WorkOrder       WorkOrder[]

  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId])
}

model EquipmentQrCode {
  id                String    @id
  tenantId          String
  equipmentId       String    @unique
  qrId              String    @unique
  qrUrl             String
  isActive          Boolean   @default(true)
  generatedAt       DateTime  @default(now())
  lastRegeneratedAt DateTime?
  version           Int       @default(1)
  equipment         Equipment @relation(fields: [equipmentId], references: [id])
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
}

model HrAnnouncement {
  id                String    @id
  tenantId          String
  title             String
  content           String
  type              String    @default("info")
  priority          String    @default("normal")
  targetRoles       String?
  targetDepartments String?
  isPopup           Boolean   @default(false)
  popupExpiry       DateTime?
  status            String    @default("published")
  publishedBy       String?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  tenant            Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, type])
}

model HrAssetAssignment {
  id           String     @id
  tenantId     String
  employeeId   String
  assetType    String
  assetName    String
  assetId      String?
  serialNumber String?
  assignedDate DateTime   @default(now())
  returnDate   DateTime?
  status       String     @default("assigned")
  condition    String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  HrEmployee   HrEmployee @relation(fields: [employeeId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId, assetType])
  @@index([tenantId, employeeId])
}

model HrCandidate {
  id             String        @id
  tenantId       String
  jobId          String
  name           String
  email          String
  phone          String?
  resumeUrl      String?
  coverLetterUrl String?
  source         String?
  status         String        @default("applied")
  appliedAt      DateTime      @default(now())
  interviewDate  DateTime?
  interviewerId  String?
  offerSalary    Float?
  offerDate      DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  HrJobPosition  HrJobPosition @relation(fields: [jobId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, jobId])
}

model HrDisciplinaryAction {
  id           String     @id
  tenantId     String
  employeeId   String
  type         String
  severity     String     @default("minor")
  description  String
  incidentDate DateTime
  actionTaken  String?
  documentUrl  String?
  issuedBy     String?
  status       String     @default("active")
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  HrEmployee   HrEmployee @relation(fields: [employeeId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId, type])
  @@index([tenantId, employeeId])
}

model HrEmployee {
  id                   String                 @id
  tenantId             String
  userId               String                 @unique
  employeeId           String
  departmentId         String?
  designation          String?
  employmentType       String                 @default("full_time")
  reportingToId        String?
  basicSalary          Float?
  nationality          String?
  passportNumber       String?
  passportExpiry       DateTime?
  visaNumber           String?
  visaExpiry           DateTime?
  drivingLicense       String?
  drivingLicenseExpiry DateTime?
  joiningDate          DateTime?
  probationEnds        DateTime?
  contractEnd          DateTime?
  bankName             String?
  bankAccount          String?
  bankBranch           String?
  emergencyName        String?
  emergencyPhone       String?
  emergencyRelation    String?
  dateOfBirth          DateTime?
  gender               String?
  maritalStatus        String?
  bloodGroup           String?
  photo                String?
  status               String                 @default("active")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  shiftId              String?
  HrAssetAssignment    HrAssetAssignment[]
  HrDisciplinaryAction HrDisciplinaryAction[]
  department           Department?            @relation(fields: [departmentId], references: [id])
  HrShift              HrShift?               @relation(fields: [shiftId], references: [id])
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  HrEmployeeDocument   HrEmployeeDocument[]
  HrExpenseClaim       HrExpenseClaim[]
  HrLeaveRequest       HrLeaveRequest[]
  HrMedicalRecord      HrMedicalRecord[]
