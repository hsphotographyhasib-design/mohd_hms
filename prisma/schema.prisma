  errorCode   String? // P2002, 401, ECONNREFUSED, etc.
  message     String // Technical message
  userMessage String? // Friendly message shown to user

  module      String? // complaints, work-orders, dashboard, etc.
  apiEndpoint String? // POST /api/complaints
  httpMethod  String? // GET, POST, PATCH, DELETE
  httpStatus  Int?
  duration    Int? // Request duration in ms

  requestBody  String? // Sanitized request body
  responseBody String? // API response body
  headers      String? // Sanitized headers JSON
  stackTrace   String? // Stack trace (dev/super_admin only)

  browser String?
  device  String?
  ip      String?
  pageUrl String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([category])
  @@index([errorRef])
  @@index([createdAt])
  @@index([userId])
}

