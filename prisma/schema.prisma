  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Service Package
// ─────────────────────────────────────────────────────────────────────────────

model ServicePackage {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  packageCode  String?
  pricingModel String?  @default("fixed")
  costPrice    Float?   @default(0)
  sellingPrice Float?   @default(0)
  discount     Float?   @default(0)
  taxRate      Float?   @default(0)
  currency     String?  @default("AED")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ServicePackageItem ServicePackageItem[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Labour Rate
// ─────────────────────────────────────────────────────────────────────────────

model LabourRate {
  id              String    @id @default(cuid())
  tenantId        String
  labourCode      String?
  technicianGrade String?
  skillLevel      String?
  hourlyCost      Float?    @default(0)
  hourlyCharge    Float?    @default(0)
  overtimeRate    Float?    @default(0)
  weekendRate     Float?    @default(0)
  holidayRate     Float?    @default(0)
  effectiveDate   DateTime?
  status          String?   @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Conversation Log
// ─────────────────────────────────────────────────────────────────────────────

model AiConversationLog {
  id               String   @id @default(cuid())
  tenantId         String
  sessionId        String
  customerId       String?
  phoneNumber      String?
  userMessage      String?
  aiResponse       String?
  detectedIntent   String?
  detectedLanguage String?
  confidence       Float?
  actionTaken      String?
  actionData       String?
  responseTimeMs   Int?
  createdAt        DateTime @default(now())

  @@index([tenantId, sessionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment Verification
// ─────────────────────────────────────────────────────────────────────────────

model PaymentVerification {
  id                String    @id @default(cuid())
  tenantId          String
  customerId        String?
  sessionId         String?
  invoiceId         String?
  imageUrl          String?
  extractedAmount   Float?
  extractedDate     String?
  extractedBank     String?
  extractedTxnId    String?
  extractedSender   String?
  extractedRef      String?
  rawAiResponse     String?
  status            String?   @default("pending")
  verifiedById      String?
  verifiedAt        DateTime?
  verificationNotes String?
  rejectionReason   String?
  invoiceClosed     Boolean?  @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved Location
// ─────────────────────────────────────────────────────────────────────────────

model SavedLocation {
  id            String   @id @default(cuid())
  tenantId      String
  customerId    String
  label         String?
  building      String?
  floor         String?
  unit          String?
  address       String?
  district      String?
  postalCode    String?
  latitude      Float?
  longitude     Float?
  accuracy      Float?
  googlePlaceId String?
  fullAddress   String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, customerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Service Item Material (child of ServiceItem)
// ─────────────────────────────────────────────────────────────────────────────

model ServiceItemMaterial {
  id                   String      @id @default(cuid())
  serviceItemId        String
  materialName         String?
  quantity             Float?      @default(0)
  unit                 String?
  estimatedConsumption Float?
  isMandatory          Boolean?    @default(false)
  sortOrder            Int         @default(0)
  serviceItem          ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)

  @@index([serviceItemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Service Item Equipment (child of ServiceItem)
// ─────────────────────────────────────────────────────────────────────────────

model ServiceItemEquipment {
  id                  String      @id @default(cuid())
  serviceItemId       String
  equipmentName       String?
  quantity            Int?        @default(1)
  isMandatory         Boolean?    @default(false)
  calibrationRequired Boolean?    @default(false)
  sortOrder           Int         @default(0)
  serviceItem         ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)

  @@index([serviceItemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Service Checklist Item (child of ServiceItem)
// ─────────────────────────────────────────────────────────────────────────────

model ServiceChecklistItem {
  id            String      @id @default(cuid())
  serviceItemId String
  task          String?
  description   String?
  sortOrder     Int         @default(0)
  serviceItem   ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)

  @@index([serviceItemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Service Package Item (child of ServicePackage)
// ─────────────────────────────────────────────────────────────────────────────

model ServicePackageItem {
  id             String         @id @default(cuid())
  packageId      String
  serviceItemId  String
  quantity       Int?           @default(1)
  sortOrder      Int            @default(0)
  servicePackage ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}
