# Hostinger Business Hosting — FacilityPro
# This file should be placed in the application root directory.
# It ensures Apache/LiteSpeed passes all requests to the Node.js app.

# Enable rewrite engine
RewriteEngine On

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# If the request is not a real file or directory, pass to Node.js
# (cPanel Passenger handles this, but this provides a fallback)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d