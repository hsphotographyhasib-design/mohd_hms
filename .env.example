# =============================================================
# Environment Variables — Copy this to .env and fill in values
# =============================================================

# REQUIRED: PostgreSQL connection string
# For Vercel: Use Neon, Supabase, or Vercel Postgres
# For local dev: Use the same cloud DB or a local PostgreSQL instance
# Example (Neon):     postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Example (Supabase): postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Example (local):    postgresql://postgres:postgres@localhost:5432/mydb
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# JWT secret for authentication (generate a random 32+ char string)
JWT_SECRET="your-jwt-secret-here"

# Optional: App URL (used for email links, webhooks, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API URL — leave empty for local dev (same-origin /api/...)
# Set to your Render backend URL for Vercel deployment
# Example: NEXT_PUBLIC_API_URL=https://mohd-hms.onrender.com
NEXT_PUBLIC_API_URL=""

# =============================================================
# Firebase Cloud Messaging (FCM) — Push Notifications
# =============================================================
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
# 
# For Vercel (frontend) — set the NEXT_PUBLIC_ vars:
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
#
# For Render (backend) — set these server-only vars:
# FIREBASE_PROJECT_ID=""              (same as above)
# FIREBASE_CLIENT_EMAIL=""             (from Firebase Console → Service Accounts → Generate New Private Key)
# FIREBASE_PRIVATE_KEY=""               (the full private key JSON string from the service account key file)
#
# For Google OAuth:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================
# OpenWA v0.8+ — WhatsApp Integration (self-hosted)
# =============================================================
# OpenWA runs as a mini-service on port 3002 (baileys engine, no Chrome needed)
# See: mini-services/openwa/ for setup instructions
OPENWA_SERVICE_URL="http://127.0.0.1:3002"
OPENWA_SESSION_NAME="MOHDHMS"
OPENWA_API_KEY="dev-admin-key"
OPENWA_WEBHOOK_SECRET=""